# Streamlit Secrets Configuration
# Copy this file to secrets.toml and fill in your values
# NEVER commit secrets.toml to git!

[connections.supabase]
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-supabase-anon-key"

[spotify]
CLIENT_ID = "your-spotify-client-id"
CLIENT_SECRET = "your-spotify-client-secret"
REDIRECT_URI = "http://localhost:8501/1_connect_spotify"
# For production, update REDIRECT_URI to your deployed URL

[ticketmaster]
API_KEY = "your-ticketmaster-api-key"
CITY = "Austin"
STATE_CODE = "TX"
SEARCH_RADIUS = "100"

[seatgeek]
CLIENT_ID = "your-seatgeek-client-id"
